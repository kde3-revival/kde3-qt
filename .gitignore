# Build artifacts of the in-tree Qt3 build (configure + make)

# configure output
/config.status
/.qmake.cache
.qmake.internal.cache
/include/qconfig.h
/include/qmodules.h
/mkspecs/default
/src/tools/qconfig.cpp
/config.tests/unix/*/*test

# qmake-generated Makefiles (the few Makefiles in the sources are tracked,
# and gitignore does not affect tracked files)
Makefile

# objects, moc and uic output directories
*.o
.obj/
.moc/
.ui/
qmake_image_collection.cpp

# libraries and helpers produced in lib/
/lib/*.so*
/lib/*.a
/lib/*.la
/lib/*.prl
/lib/*.pc

# binaries produced in bin/ (bin/findtr, bin/qt20fix, bin/qtrename140 are tracked scripts)
/bin/assistant
/bin/designer
/bin/linguist
/bin/lrelease
/bin/lupdate
/bin/moc
/bin/qm2ts
/bin/qmake
/bin/qtconfig
/bin/uic

# plugins
/plugins/*/*.so

