	if [ "$acceptance" = "yes" ]; then
	    break
	elif [ "$acceptance" = "no" ] ;then
	    echo "You are not licensed to use this software."
	    echo
	    exit 0
	elif [ "$acceptance" = "?" ]; then
	    more $relpath/LICENSE.EVAL
	fi
    done
